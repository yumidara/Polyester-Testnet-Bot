# Copy to .env and fill in. .env is gitignored -- never commit a real key.
# Wallet private key (0x-prefixed) for the Polyester testnet account.
PK=0x....

# --- optional ---
# Sepolia RPC used by the injected signing bridge.
# SEPOLIA_RPC=https://ethereum-sepolia-rpc.publicnode.com
# Chain id (default 11155111)
# CHAIN_ID=11155111
# CDP port of the attached Chrome instance (default 9333)
# CDP_PORT=9333
